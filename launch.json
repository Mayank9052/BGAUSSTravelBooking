{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run Backend (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BgaussTravel.API/bin/Debug/net10.0/BgaussTravel.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BgaussTravel.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger/index.html"
      }
    },
    {
      "name": "⚛️ Run Frontend (React)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/bgauss-travel-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🔥 Run Full Stack (API + UI)",
      "configurations": [
        "🚀 Run Backend (Swagger)",
        "⚛️ Run Frontend (React)"
      ]
    }
  ]
}